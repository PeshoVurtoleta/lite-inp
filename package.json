{
  "name": "@zakkster/lite-inp",
  "version": "1.0.1",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "description": "Zero-GC INP attribution via Event Timing API + Long Animation Frames. Preallocated struct-of-arrays for interactions and LoAF entries. The observer callbacks write to typed arrays, not objects.",
  "type": "module",
  "sideEffects": false,
  "main": "./Inp.js",
  "module": "./Inp.js",
  "types": "./Inp.d.ts",
  "exports": {
    ".": {
      "types": "./Inp.d.ts",
      "node": "./Inp.js",
      "import": "./Inp.js",
      "default": "./Inp.js"
    }
  },
  "files": [
    "Inp.js",
    "Inp.d.ts",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "inp",
    "interaction-to-next-paint",
    "core-web-vitals",
    "cwv",
    "event-timing",
    "loaf",
    "long-animation-frames",
    "attribution",
    "performance",
    "zero-gc",
    "lite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://github.com/PeshoVurtoleta/lite-inp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-inp.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-inp/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.15.0",
    "@zakkster/lite-leak": "^1.8.1",
    "@zakkster/lite-signal": "^1.5.0-rc.1"
  }
}
